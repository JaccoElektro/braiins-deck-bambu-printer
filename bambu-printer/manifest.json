{
  "$schema": "../bmc-sdk/bmc-widget-manifest/manifest.schema.json",
  "uid": "0505798b-def7-4503-a456-48de51061d41",
  "version": "1.0.0",
  "name": "Bambu Lab Printer",
  "subname": "Print status, AMS and camera",
  "description": "Live status of a Bambu Lab printer over your local network: progress, layer, time left, temperatures, every AMS spool with colour and amount left, and alerts on the light strip",
  "config_help": "Needs the small bambu-bridge on a computer in your network (see the README). The printer's access code stays on that computer; the Deck only reads status.",
  "author": {
    "name": "Jacco",
    "url": "https://github.com/jaccoelektro/braiins-deck-bambu-printer"
  },
  "binary": "bin/bambu-printer",
  "icon": "assets/icon.svg",
  "category": "utility",
  "settings": [
    "localization",
    "timezone",
    "nightMode"
  ],
  "supported_viewports": [
    {
      "type": "rectangular",
      "min_width": 317,
      "max_width": 1280,
      "min_height": 238,
      "max_height": 480
    }
  ],
  "params": {
    "bridge_url": {
      "name": "Bridge URL",
      "description": "Address of bambu-bridge, e.g. http://192.168.1.20:9152",
      "type": "string",
      "default_value": "",
      "format": "uri"
    },
    "printer_name": {
      "name": "Printer name",
      "type": "string",
      "default_value": "Bambu Lab"
    },
    "language": {
      "name": "Language",
      "type": "string",
      "optional": true,
      "enum_values": [
        {
          "value": "en",
          "label": "English"
        },
        {
          "value": "nl",
          "label": "Nederlands"
        }
      ]
    },
    "alerts": {
      "name": "Alerts",
      "description": "Light strip and sound when a print finishes, fails, pauses or a spool runs low",
      "type": "boolean",
      "default_value": true
    },
    "light_theme": {
      "name": "Light theme",
      "type": "boolean",
      "default_value": false
    },
    "scene_fx": {
      "name": "Scene entry effect",
      "description": "A soft green breath on the light strip when the scene slides in",
      "type": "boolean",
      "optional": true
    }
  }
}
